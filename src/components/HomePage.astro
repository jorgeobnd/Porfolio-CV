---
import Layout from "@/layouts/Layout.astro";

import AboutMe from "@/components/AboutMe.astro";
import BriefCase from "@/components/icons/BriefCase.astro";
import Code from "@/components/icons/Code.astro";
import Cpu from "@/components/icons/Cpu.astro";
import Experience from "@/components/Experience.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import Project from "@/components/Project.astro";
import SaasifyProjects from "@/components/SaasifyProjects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Stack from "@/components/icons/Stack.astro";
import TechStack from "@/components/TechStack.astro";
import Hero from "@/components/Hero.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("meta.title")} description={t("meta.description")}>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <h2
          class="flex items-center mb-6 text-4xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <BriefCase class="size-8" />
          {t("section.experience")}
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="saasify">
        <h2
          class="flex items-center mb-6 text-4xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Stack class="size-7" />
          {t("section.saasify")}
        </h2>
        <SaasifyProjects />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <h2
          class="flex items-center mb-6 text-4xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Code class="size-7" />
          {t("section.projects")}
        </h2>
        <Project />
      </SectionContainer>

      <SectionContainer id="tecnologias">
        <h2
          class="flex items-center mb-6 text-4xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Cpu class="size-7" />
          {t("section.tech")}
        </h2>
        <TechStack />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
        >
          <ProfileCheck class="size-8" />
          {t("section.about")}
        </h2>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
